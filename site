  </div>
  <svg class="pipe-svg" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice">
    <path class="pipe-path" d="M20,480 L20,320 Q20,290 50,290 L220,290 Q250,290 250,260 L250,120 Q250,90 280,90 L380,90" />
    <circle class="pipe-dot" cx="380" cy="90" r="7"/>
