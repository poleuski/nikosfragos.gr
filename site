<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Φράγκος — Υδραυλικές Υπηρεσίες</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --blue-deep:#0E3B53;
    --blue-mid:#144E6E;
    --teal:#1E8F72;
    --yellow:#F5C518;
    --paper:#F6F7F4;
    --ink:#10262E;
    --ink-soft:#4C6470;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Work Sans', sans-serif;
    background:var(--paper);
    color:var(--ink);
    line-height:1.5;
  }
  h1,h2,h3,.brand{
    font-family:'Space Grotesk', sans-serif;
  }
  a{color:inherit;}

  /* ---------- top bar ---------- */
  header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:1.4rem 6vw;
    position:sticky;
    top:0;
    background:rgba(246,247,244,0.9);
    backdrop-filter:blur(6px);
    z-index:10;
  }
  .brand{
    display:flex;
    align-items:center;
  }
  .brand img{
    height:38px;
    width:auto;
    display:block;
  }
  .call-pill{
    display:inline-flex;
    align-items:center;
    gap:0.5rem;
    background:var(--blue-deep);
    color:#fff;
    padding:0.6rem 1.1rem;
    border-radius:999px;
    text-decoration:none;
    font-size:0.92rem;
    font-weight:500;
    transition:background 0.2s ease;
  }
  .call-pill:hover{background:var(--teal);}
  .call-pill svg{width:16px; height:16px; flex-shrink:0;}

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    background:var(--blue-deep);
    color:#fff;
    padding:6.5rem 6vw 5.5rem;
    overflow:hidden;
  }
  .hero-inner{
    position:relative;
    z-index:2;
    max-width:640px;
  }
  .hero h1{
    font-size:clamp(2.2rem, 5.2vw, 3.6rem);
    font-weight:700;
    line-height:1.08;
    letter-spacing:-0.01em;
  }
  .hero p{
    margin-top:1.3rem;
    font-size:1.08rem;
    color:#CFE3EA;
    max-width:34ch;
  }
  .hero-cta{
    margin-top:2.2rem;
    display:flex;
    flex-wrap:wrap;
    gap:1rem;
    align-items:center;
  }
  .btn-primary{
    background:var(--yellow);
    color:var(--blue-deep);
    font-weight:600;
    padding:0.95rem 1.6rem;
    border-radius:8px;
    text-decoration:none;
    font-size:1.02rem;
    display:inline-flex;
    align-items:center;
    gap:0.6rem;
    transition:transform 0.15s ease;
  }
  .btn-primary:hover{transform:translateY(-2px);}
  .hero-hours{
    font-size:0.9rem;
    color:#9FC1CE;
  }

  /* pipe line decoration */
  .pipe-svg{
    position:absolute;
    right:-4%;
    top:0;
    height:100%;
    width:56%;
    z-index:1;
    opacity:0.9;
  }
  .pipe-path{
    fill:none;
    stroke:var(--teal);
    stroke-width:3;
    stroke-linecap:round;
    stroke-dasharray:900;
    stroke-dashoffset:900;
    animation:draw 2.4s ease forwards 0.3s;
  }
  .pipe-dot{
    fill:var(--yellow);
    opacity:0;
    animation:fadein 0.6s ease forwards 2.2s;
  }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  @keyframes fadein{ to{ opacity:1; } }
  @media (prefers-reduced-motion: reduce){
    .pipe-path{animation:none; stroke-dashoffset:0;}
    .pipe-dot{animation:none; opacity:1;}
  }

  /* ---------- services ---------- */
  section{
    padding:4.5rem 6vw;
  }
  .section-head{
    max-width:46ch;
    margin-bottom:2.6rem;
  }
  .section-head h2{
    font-size:1.9rem;
    color:var(--blue-deep);
  }
  .section-head p{
    margin-top:0.6rem;
    color:var(--ink-soft);
  }

  .service-list{
    display:flex;
    flex-wrap:wrap;
    border-top:1px solid #D9DEDA;
  }
  .service-item{
    flex:1 1 260px;
    padding:1.6rem 1.6rem 1.6rem 0;
    border-bottom:1px solid #D9DEDA;
    display:flex;
    gap:1rem;
    align-items:flex-start;
  }
  .service-item svg{
    width:26px;
    height:26px;
    flex-shrink:0;
    stroke:var(--teal);
    margin-top:0.15rem;
  }
  .service-item h3{
    font-size:1.08rem;
    font-weight:500;
    margin-bottom:0.3rem;
    color:var(--ink);
  }
  .service-item p{
    font-size:0.92rem;
    color:var(--ink-soft);
  }

  /* ---------- why us ---------- */
  .why{
    background:#EAF2EE;
  }
  .why-grid{
    display:flex;
    flex-wrap:wrap;
    gap:2.6rem;
    max-width:900px;
  }
  .why-item{
    flex:1 1 220px;
  }
  .why-item .num{
    font-family:'Space Grotesk', sans-serif;
    font-size:0.95rem;
    color:var(--teal);
    font-weight:700;
    display:block;
    margin-bottom:0.4rem;
  }
  .why-item h3{
    font-size:1.05rem;
    font-weight:500;
    margin-bottom:0.35rem;
  }
  .why-item p{
    font-size:0.92rem;
    color:var(--ink-soft);
  }

  /* ---------- contact / footer ---------- */
  footer{
    background:var(--blue-deep);
    color:#fff;
    padding:4rem 6vw 2.2rem;
  }
  .footer-top{
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    gap:2.5rem;
    padding-bottom:2.5rem;
    border-bottom:1px solid rgba(255,255,255,0.15);
  }
  .footer-top h2{
    font-size:1.7rem;
    max-width:16ch;
    line-height:1.2;
  }
  .footer-call{
    display:flex;
    flex-direction:column;
    gap:0.8rem;
    align-items:flex-start;
  }
  .footer-call a.phone-link{
    font-family:'Space Grotesk', sans-serif;
    font-size:1.7rem;
    font-weight:700;
    color:var(--yellow);
    text-decoration:none;
  }
  .footer-note{
    font-size:0.85rem;
    color:#9FC1CE;
  }
  .footer-bottom{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:0.6rem;
    padding-top:1.4rem;
    font-size:0.82rem;
    color:#7FA3B2;
  }

  @media (max-width:640px){
    header{padding:1.1rem 5vw;}
    .hero{padding:4rem 5vw 3.5rem;}
    section{padding:3.2rem 5vw;}
    .pipe-svg{display:none;}
    .footer-top{flex-direction:column;}
  }

  a:focus-visible, button:focus-visible{
    outline:3px solid var(--yellow);
    outline-offset:2px;
  }
</style>
</head>
<body>

<header>
  <div class="brand"><img src="data:image/png;base64," alt="Φράγκος — Υδραυλικές Υπηρεσίες"></div>
  <a class="call-pill" href="tel:+306973633015">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    6973 633 015
